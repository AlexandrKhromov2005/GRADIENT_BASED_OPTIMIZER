CXX = g++
CXXFLAGS = -std=c++17 -O2
INCLUDES = -I. -I/usr/include/opencv4
LIBS = -lopencv_core -lopencv_imgproc -lopencv_imgcodecs -lopencv_highgui

# Try to add PyTorch libraries if available
TORCH_PATH = /tmp/libtorch
ifneq (,$(wildcard $(TORCH_PATH)))
    INCLUDES += -I$(TORCH_PATH)/include -I$(TORCH_PATH)/include/torch/csrc/api/include
    LIBS += -L$(TORCH_PATH)/lib -ltorch -ltorch_cpu -lc10
    CXXFLAGS += -DTORCH_AVAILABLE
    LDFLAGS = -Wl,-rpath,$(TORCH_PATH)/lib
endif

SOURCES = run_experiment.cpp \
          GRADIENT_BASED_OPTIMIZER/src/dataset_generation.cpp \
          GRADIENT_BASED_OPTIMIZER/src/embedding_schemes.cpp \
          GRADIENT_BASED_OPTIMIZER/src/embedding_with_classifier.cpp \
          GRADIENT_BASED_OPTIMIZER/src/single_classifier.cpp \
          GRADIENT_BASED_OPTIMIZER/src/ensemble_classifier.cpp \
          GRADIENT_BASED_OPTIMIZER/src/gbo.cpp \
          GRADIENT_BASED_OPTIMIZER/src/population.cpp \
          GRADIENT_BASED_OPTIMIZER/src/random_utils.cpp \
          GRADIENT_BASED_OPTIMIZER/src/block_metrics.cpp \
          GRADIENT_BASED_OPTIMIZER/src/image_processing_custom.cpp

experiment: $(SOURCES)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -o experiment $(SOURCES) $(LIBS) $(LDFLAGS)

clean:
	rm -f experiment

.PHONY: clean